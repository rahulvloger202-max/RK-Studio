<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- PrimX IDE - Light Theme -->
    <style name="Theme.PrimX.Light" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="ide_bg_color">#F5F5F5</item>
        <item name="ide_dialog_bg_color">#FFFFFF</item>
        <item name="ide_text_primary">#212121</item>
        <item name="ide_text_secondary">#757575</item>
        <item name="ide_icon_tint">#424242</item>
        <item name="ide_stroke_color">#3574F0</item>
        <item name="ide_border_color">#40000000</item>

        <!-- 🔥 Tab bar Light -->
        <item name="ide_tab_active_bg">#FFFFFF</item>
        <item name="ide_tab_inactive_bg">#E8E8E8</item>
        <item name="ide_tab_active_text">#3574F0</item>
        <item name="ide_tab_inactive_text">#757575</item>
        <item name="ide_tab_indicator_color">#3574F0</item>

        <!-- 🔥 Log level Light -->
        <item name="ide_log_info_color">#0277BD</item>
        <item name="ide_log_success_color">#2E7D32</item>
        <item name="ide_log_warning_color">#F57F17</item>
        <item name="ide_log_error_color">#D32F2F</item>

        <!-- Editor Light Mode Fit -->
        <item name="editor_bg_color">#FFFFFF</item>
        <item name="editor_plain_text_color">#1F2328</item>
        <item name="editor_active_line_color">#FFFDE7</item>
        <item name="editor_indent_line_color">#D0D7DE</item>
        <item name="editor_line_number_color">#8C959F</item>

        <!-- 🔥 REMOVE YELLOW TAP EFFECT (Light Mode Premium Ripple) -->
        <item name="android:colorPressedHighlight">#1A000000</item> <!-- 10% Black (Soft Grey) -->
        <item name="android:colorControlHighlight">#1A000000</item>
    </style>

    <!-- PrimX IDE - Dark Theme -->
    <style name="Theme.PrimX.Dark" parent="@android:style/Theme.NoTitleBar">
        <item name="ide_bg_color">#1E1E1E</item>
        <item name="ide_dialog_bg_color">#2D2D2D</item>
        <item name="ide_text_primary">#E0E0E0</item>
        <item name="ide_text_secondary">#9E9E9E</item>
        <item name="ide_icon_tint">#E0E0E0</item>
        <item name="ide_stroke_color">#3574F0</item>
        <item name="ide_border_color">#33FFFFFF</item>

        <!-- 🔥 Tab bar Dark -->
        <item name="ide_tab_active_bg">#2D2D2D</item>
        <item name="ide_tab_inactive_bg">#1E1E1E</item>
        <item name="ide_tab_active_text">#3574F0</item>
        <item name="ide_tab_inactive_text">#9E9E9E</item>
        <item name="ide_tab_indicator_color">#3574F0</item>

        <!-- 🔥 Log level Dark -->
        <item name="ide_log_info_color">#80D8FF</item>
        <item name="ide_log_success_color">#4CAF50</item>
        <item name="ide_log_warning_color">#FFC107</item>
        <item name="ide_log_error_color">#FF5252</item>

        <!-- Editor Dark Mode Fit -->
        <item name="editor_bg_color">#121212</item>
        <item name="editor_plain_text_color">#E6EDF3</item>
        <item name="editor_active_line_color">#1E2430</item>
        <item name="editor_indent_line_color">#30363D</item>
        <item name="editor_line_number_color">#7D8590</item>

        <!-- 🔥 REMOVE YELLOW TAP EFFECT (Dark Mode Premium Ripple) -->
        <item name="android:colorPressedHighlight">#1AFFFFFF</item> <!-- 10% White (Soft Light) -->
        <item name="android:colorControlHighlight">#1AFFFFFF</item>
    </style>

</resources>
