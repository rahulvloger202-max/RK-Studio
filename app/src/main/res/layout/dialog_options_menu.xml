<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:minWidth="320dp"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/bg_whit_blac_theme_hard_blue_stroke_all"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/tvMenuTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="File Name"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/ide_text_primary"
        android:layout_marginBottom="12dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/ide_border_color"/>

    <!-- New Folder Option -->
    <LinearLayout
        android:id="@+id/optNewFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_tree_folder"
            android:background="@drawable/bg_whit_blac_strok_pill"
            android:padding="9dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Folder"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFA0FF83"
            android:layout_marginStart="16dp"/>

    </LinearLayout>

    <!-- New File Option -->
    <LinearLayout
        android:id="@+id/optNewFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_tree_file"
            android:background="@drawable/bg_whit_blac_strok_pill"
            android:padding="9dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New File"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFD864"
            android:layout_marginStart="16dp"/>

    </LinearLayout>

    <!-- Rename Option (🔥 यहाँ ic_rename पर android:tint जोड़ दिया गया है) -->
    <LinearLayout
        android:id="@+id/optRename"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_rename"
            android:background="@drawable/bg_whit_blac_strok_pill"
            android:tint="?attr/ide_icon_tint"
            android:padding="9dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rename"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFB49FF9"
            android:layout_marginStart="16dp"/>

    </LinearLayout>

    <!-- Delete Option -->
    <LinearLayout
        android:id="@+id/optDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_delete"
            android:background="@drawable/bg_whit_blac_strok_pill"
            android:padding="9dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFA66D7"
            android:layout_marginStart="16dp"/>

    </LinearLayout>

</LinearLayout>

