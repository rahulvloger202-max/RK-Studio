<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_whit_blac_theme">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="6dp"
        android:background="@drawable/bg_whit_blac_theme">

        <LinearLayout
            android:id="@+id/normalToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical"
            android:visibility="visible">

            <ImageView
                android:id="@+id/btnOpenMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_split_screen"
                android:tint="?attr/ide_icon_tint"
                android:padding="8dp"
                android:layout_marginEnd="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"/>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/layoutTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Project"
                        android:textColor="?attr/ide_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02"/>

                    <TextView
                        android:id="@+id/tvProjectName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No Project"
                        android:textColor="#61AFEF"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

                <!-- Premium Rounded Search Bar with Pill Stroke -->
                <LinearLayout
                    android:id="@+id/layoutSearchBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    android:background="@drawable/bg_whit_blac_strok_pill"
                    android:elevation="2dp"
                    android:paddingEnd="4dp">

                    <EditText
                        android:id="@+id/inputEditorSearch"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="Search code..."
                        android:textColor="?attr/ide_text_primary"
                        android:textColorHint="?attr/ide_text_secondary"
                        android:textSize="15sp"
                        android:paddingStart="16dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:singleLine="true"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:background="@null"/>

                    <ImageView
                        android:id="@+id/btnClearSearch"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:tint="?attr/ide_icon_tint"
                        android:layout_marginStart="4dp"
                        android:padding="8dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"/>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/layoutDefaultActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="8dp"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/btnRun"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_run"
                    android:tint="#98C379"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"/>

                <ImageView
                    android:id="@+id/btnEdit"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_edit"
                    android:layout_marginStart="4dp"
                    android:tint="?attr/ide_icon_tint"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"/>

                <ImageView
                    android:id="@+id/btnEditorMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_more"
                    android:layout_marginStart="4dp"
                    android:tint="?attr/ide_icon_tint"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutTypingActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btnUndo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_undo"
                    android:tint="#61AFEF"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"/>

                <ImageView
                    android:id="@+id/btnRedo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_redo"
                    android:layout_marginStart="4dp"
                    android:tint="#61AFEF"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"/>

                <ImageView
                    android:id="@+id/btnSaveApp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_save"
                    android:layout_marginStart="4dp"
                    android:tint="#E5C07B"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 🔥 Floating Selection Bar with Shadow Pill -->
        <LinearLayout
            android:id="@+id/floatingSelectionBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:gravity="center"
            android:visibility="gone"
            android:background="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_shadow_pill"
                android:elevation="8dp">

                <ImageView
                    android:id="@+id/btnSelectAll"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_select_all"
                    android:tint="?attr/ide_icon_tint"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"/>

                <ImageView
                    android:id="@+id/btnCut"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_cut"
                    android:tint="?attr/ide_icon_tint"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"/>

                <ImageView
                    android:id="@+id/btnCopy"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_copy"
                    android:tint="?attr/ide_icon_tint"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"/>

                <ImageView
                    android:id="@+id/btnPaste"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_paste"
                    android:tint="?attr/ide_icon_tint"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"/>

                <!-- Replace Button Removed, Comment Button Added Here -->
                <ImageView
                    android:id="@+id/btnComment"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_comment"
                    android:tint="?attr/ide_icon_tint"
                    android:padding="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"/>

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#20888888"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="@drawable/bg_whit_blac_theme">

        <LinearLayout
            android:id="@+id/tabContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#20888888"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_whit_blac_theme">

        <com.primx.ui.editor.EditorView
            android:id="@+id/codeCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
