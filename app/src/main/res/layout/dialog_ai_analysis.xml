<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_whit_blac_theme">

    <!-- ScrollView: Yeh sabse peechhe rahega taaki text floating buttons ke neeche se nikle -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="72dp"
        android:paddingBottom="120dp"
        android:fillViewport="true"
        android:fadeScrollbars="false"
        android:background="@android:color/transparent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvAiContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome! Ask me to fix errors or build a feature...\n\n(Scroll me behind the floating boxes just like Gemini!)"
                android:textColor="?attr/ide_text_primary"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:textIsSelectable="true"/>

        </RelativeLayout>
    </ScrollView>
    <!-- 🔥 NAYA: PrimX Copilot tairta hua label (Left Side) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_circle_stroke_theme"
        android:elevation="4dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PrimX Copilot"
            android:textColor="?attr/ide_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 🔥 Settings Icon (Right Side - Balanced Size) -->
    <RelativeLayout
        android:id="@+id/settingsContainer"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_circle_stroke_theme"
        android:elevation="4dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/btnAiSettings"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_settings"
            android:tint="?attr/ide_icon_tint"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="3dp"
            android:clickable="true"/>

    </RelativeLayout>

    <!-- Bottom Action Container -->
    <LinearLayout
        android:id="@+id/bottomActionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@drawable/bg_shadow_strok"
        android:elevation="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <EditText
                android:id="@+id/inputAiCommand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/ide_text_primary"
                android:textColorHint="?attr/ide_text_secondary"
                android:hint="Ask PrimX..."
                android:background="@null"
                android:maxLines="4"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="15sp"/>

            <ImageView
                android:id="@+id/btnSendAiCommand"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_send"
                android:tint="?attr/ide_stroke_color"
                android:padding="8dp"
                android:layout_marginEnd="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/btnAiSaveToProject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAVE"
                android:textColor="?attr/ide_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:clickable="true"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/btnAiCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="CANCEL"
                android:textColor="?attr/ide_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"/>

            <TextView
                android:id="@+id/btnAiFix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:padding="8dp"
                android:text="SCAN"
                android:textColor="?attr/ide_stroke_color"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"/>

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
