<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_whit_blac_theme">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ========================================== -->
        <!-- 1. Top Header & Search Area (OVERLAPPING)  -->
        <!-- ========================================== -->
        <!-- FrameLayout का इस्तेमाल ताकि सर्च बॉक्स हेडर के ऊपर आ सके -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_whit_blac_theme">

            <!-- डिफ़ॉल्ट हेडर (Create Project + Search Icon) -->
            <LinearLayout
                android:id="@+id/headerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/btnCreateProject"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true">

                    <!-- 🔥 यहाँ से tint हटा दिया गया है ताकि असली रंग दिखें -->
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_add_project"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Create New Project"
                        android:textColor="?attr/ide_text_primary"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_marginStart="16dp"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnToggleSearch"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_search"
                    android:padding="6dp"
                    android:tint="?attr/ide_icon_tint"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"/>
            </LinearLayout>

            <!-- सर्च बॉक्स (जब यह विज़िबल होगा, तो यह हेडर के बिल्कुल ऊपर आ जाएगा और उसे ढक लेगा) -->
            <LinearLayout
                android:id="@+id/searchContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:background="@drawable/bg_whit_blac_theme"
                android:elevation="4dp">

                <EditText
                    android:id="@+id/inputSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Search files..."
                    android:textSize="14sp"
                    android:textColor="?attr/ide_text_primary"
                    android:textColorHint="?attr/ide_text_secondary"
                    android:background="@drawable/bg_whit_blac_strok_pill"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text"/>
            </LinearLayout>

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/ide_border_color"/> <!-- थीम वाली हल्की लाइन -->

            <!-- ========================================== -->
            <!-- 2. Main File Tree Scroll                   -->
            <!-- ========================================== -->
            <ScrollView
                android:id="@+id/mainScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:background="@drawable/bg_whit_blac_theme">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <LinearLayout
                        android:id="@+id/fileTreeContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingTop="6dp"
                        android:paddingBottom="100dp"/>

                </HorizontalScrollView>
            </ScrollView>

        </LinearLayout>

        <!-- ========================================== -->
        <!-- 3. Refresh Icon (Swipe to Refresh style)   -->
        <!-- ========================================== -->
        <LinearLayout
            android:id="@+id/refreshCircle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@null"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:translationY="-100dp">

            <ImageView
                android:id="@+id/refreshIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_refresh"
                android:tint="?attr/ide_icon_tint"/>
        </LinearLayout>

        <!-- ========================================== -->
        <!-- 4. Dim Overlay & FAB Buttons               -->
        <!-- ========================================== -->
        <View
            android:id="@+id/dimOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:elevation="7dp"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="8dp">

            <LinearLayout
                android:id="@+id/fabFileContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:alpha="0"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create File"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_pill_blue"
                    android:elevation="4dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"/>

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_pill_blue"
                    android:elevation="4dp"
                    android:src="@drawable/ic_tree_file"
                    android:padding="10dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fabFolderContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:alpha="0"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create Folder"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_pill_blue"
                    android:elevation="4dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"/>

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_pill_blue"
                    android:elevation="4dp"
                    android:src="@drawable/ic_tree_folder"
                    android:padding="10dp"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/fabMain"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_pill_blue"
                android:src="@drawable/ic_add_white"
                android:padding="16dp"
                android:elevation="10dp"
                android:stateListAnimator="@null"/>

        </FrameLayout>
    </FrameLayout>
